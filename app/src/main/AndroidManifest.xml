<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRED on Android 11+ (API 30+): without this, the app
         cannot "see" that Chrome (or any browser) is installed, even
         if it genuinely is. This causes the TWA launch call to throw
         ActivityNotFoundException immediately on startup, which is
         exactly the "in-app error" crash we were seeing. This is a
         well-documented, common gotcha for TWA apps specifically. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Needed for the app to reach your Netlify-hosted site at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed later for the floating bubble overlay (Step 2). Declared
         now so we don't have to touch the manifest again for that step. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Needed later for the foreground call service (Step 3). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- REQUIRED on Android 14+ (API 34+): every foreground service
         must declare its type, or Android throws
         MissingForegroundServiceTypeException the moment
         startForeground() is called. The floating bubble doesn't fit
         any of Android's specific predefined types (mediaPlayback,
         location, camera, etc.), so it uses "specialUse", which
         itself requires this specific permission plus a written
         explanation attached to the service declaration below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".GamersChatApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Transparent">

        <!-- Not the launcher, only used as a fallback screen if
             GamersChatApplication's crash handler catches an
             uncaught exception anywhere in the app, so we can see
             the real error instead of a silent failure. -->
        <activity
            android:name=".MinimalTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar" />

        <!-- Step 1 of the floating-bubble feature: a standalone screen
             to request the "draw over other apps" permission. Given
             its own LAUNCHER entry for now so it's independently
             testable without touching the main TWA flow that's
             already working, once the bubble itself is built, this
             will instead be reached from inside the main app. -->
        <activity
            android:name=".OverlayPermissionActivity"
            android:exported="true"
            android:label="Voxx Chat Bubble Setup"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The TWA launcher activity, provided by the androidbrowserhelper
             library. It reads the meta-data below to know which website
             to host and trust. -->
        <activity
            android:name=".VoxxChatLauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_launch_url" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/statusBarColor" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/navigationBarColor" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- This lets the app open directly (as an installed app,
                 not a browser) if someone taps a gamerschat.app link
                 from outside the app, e.g. from a shared link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/twa_host" />
            </intent-filter>
        </activity>

        <!-- Step 2 of the floating-bubble feature: the actual
             Foreground Service that draws the bubble on screen. Uses
             "specialUse" since a floating overlay bubble doesn't fit
             any of Android's specific predefined service types. -->
        <service
            android:name=".BubbleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays a floating bubble showing voice call status and controls over other apps, including games, so the user does not have to leave what they are doing to manage a call." />
        </service>

        <!-- Required by the TWA library so notifications shown by the
             web app (via the service worker) are correctly attributed
             to this native app once installed. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
            </intent-filter>
        </service>

    </application>
</manifest>
